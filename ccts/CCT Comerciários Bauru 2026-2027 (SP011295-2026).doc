<tr>
<td nowrap="nowrap" width="416">
<p align="center"><strong>III &ndash; EMPRESAS DE PEQUENO PORTE (EPP&rsquo;s)</strong></p>
</td>
<td nowrap="nowrap" width="198">
<p align="center"><strong>VALORES A PARTIR DE 01/09/2026</strong></p>
</td>
</tr>
<tr>
<td nowrap="nowrap" width="416">
<p><strong>a</strong><strong>) </strong>Piso salarial de ingresso(180 dias)</p>
</td>
<td valign="bottom" nowrap="nowrap" width="198">
<p align="center">R$ 1.859,00</p>
</td>
</tr>
<tr>
<td nowrap="nowrap" width="416">
<p><strong>b</strong><strong>) </strong>Empregados em geral</p>
</td>
<td valign="bottom" nowrap="nowrap" width="198">
<p align="center">R$ 2.073,00</p>
</td>
</tr>
<tr>
<td nowrap="nowrap" width="416">
<p><strong>c</strong><strong>) </strong>Operadores de caixa</p>
</td>
<td valign="bottom" nowrap="nowrap" width="198">

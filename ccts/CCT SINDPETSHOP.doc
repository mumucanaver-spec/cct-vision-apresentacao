       <td width=152 valign=top style='width:114.0pt;padding:0cm 0cm 0cm 0cm'>
       <p>R$ 1.640,00*</p>
       </td>
      </tr>
      <tr style='mso-yfti-irow:5'>
       <td width=415 valign=top style='width:311.25pt;padding:0cm 0cm 0cm 0cm'>
       <p>Cuidador de Animais Domésticos;</p>

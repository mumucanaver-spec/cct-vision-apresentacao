       <p><strong>PLANILHA DE EVOLUÇÃO SALARIAL PERÍODO 01.05.2024 A 30.04.2025</strong></p>
       </td>
       <td width=1 style='width:.75pt;padding:0cm 0cm 0cm 0cm'>
       <p>&nbsp;</p>
       </td>
      </tr>
      <tr style='mso-yfti-irow:1'>
       <td width=415 valign=top style='width:311.25pt;padding:0cm 0cm 0cm 0cm'>
       <p><strong>CARGO / FUNÇÃO</strong></p>
       </td>
       <td width=151 valign=top style='width:113.25pt;padding:0cm 0cm 0cm 0cm'>
       <p><strong>VALORES</strong></p>
       </td>
       <td width=1 style='width:.75pt;padding:0cm 0cm 0cm 0cm'>
       <p>&nbsp;</p>
       </td>
      </tr>
      <tr style='mso-yfti-irow:2'>
       <td width=415 valign=top style='width:311.25pt;padding:0cm 0cm 0cm 0cm'>
       <p>Auxiliar de Almoxarifado / Apoio de loja</p>
       </td>
       <td width=151 valign=top style='width:113.25pt;padding:0cm 0cm 0cm 0cm'>

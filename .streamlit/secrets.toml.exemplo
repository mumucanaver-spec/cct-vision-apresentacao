# Cole este conteúdo em "Settings > Secrets" do app no Streamlit Community Cloud,
# trocando os valores. (Para testar no computador, salve como .streamlit/secrets.toml)

NVIDIA_API_KEY = "nvapi-..."            # chave gratuita de build.nvidia.com
SENHA_DE_ACESSO = "escolha-uma-senha"   # senha para entrar no site
GITHUB_TOKEN = "ghp_..."                # token do GitHub com permissão "repo"
GITHUB_REPOSITORIO = "seu-usuario/assistente-cct-acervo"  # repositório privado do acervo
